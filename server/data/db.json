  "prompt_versions": [
    {
      "id": "prompt-req-v1",
      "created_at": "2026-09-30T10:00:13.247Z",
      "updated_at": "2026-09-30T10:00:13.247Z",
      "feature": "requirement_analysis",
      "version": "v1.2.0",
      "is_active": true,
      "prompt_template": "Act as a Senior QA Architect and Systems Analyst. Analyze the following software requirement in depth.\nExtract and return a structured JSON object containing:\n- summary: string\n- actors: string[]\n- preconditions: string[]\n- business_rules: string[]\n- functional_requirements: string[]\n- non_functional_considerations: string[]\n- acceptance_criteria: string[]\n- ambiguities: string[] (ambiguous wording or assumptions)\n- missing_information: string[] (details developer/QA needs)\n- dependencies: string[]\n- risks: string[]\n- testable_conditions: string[]"
    },
    {
      "id": "prompt-tc-v1",
      "created_at": "2026-09-30T10:00:13.247Z",
      "updated_at": "2026-09-30T10:00:13.247Z",
      "feature": "test_case_generation",
      "version": "v1.3.0",
      "is_active": true,
      "prompt_template": "Act as a Lead QA Automation Architect. Generate comprehensive, production-grade test cases for the requirement.\nEvery test case must include: test_case_id, requirement_id, module, feature, scenario, title, preconditions, test_data, steps (array of strings), expected_result, priority (P1-Critical, P2-High, P3-Medium, P4-Low), test_type (Functional, UI, Integration, API, Regression, Smoke, Sanity, Negative, Boundary, Security, Performance, Compatibility), automation_candidate (true/false), and notes.\nEnsure deep coverage across positive, negative, boundary, validation, error handling, permission, data integrity, session, and compatibility scenarios without duplicates."
    },
    {
      "id": "prompt-reg-v1",
      "created_at": "2026-09-30T10:00:13.247Z",
      "updated_at": "2026-09-30T10:00:13.247Z",
      "feature": "regression_generation",
      "version": "v1.1.0",
      "is_active": true,
      "prompt_template": "Act as a Regression Testing Specialist. Given the updated requirement, existing test cases, and release notes/bug fixes, determine what existing functionality can be impacted (Direct, Indirect, Dependency impact).\nGenerate structured regression test cases with: regression_id, affected_module, related_requirement, scenario, steps, expected_result, priority, reason_for_regression, and classification (Critical Regression, High Regression, Medium Regression, Low Regression)."
    },
    {
      "id": "prompt-api-v1",
      "created_at": "2026-09-30T10:00:13.247Z",
      "updated_at": "2026-09-30T10:00:13.247Z",
      "feature": "api_test_generation",
      "version": "v1.2.0",
      "is_active": true,
      "prompt_template": "Act as an API Testing & RestAssured / Postman Expert. Generate structured API test cases for the given endpoint, method, headers, and payload.\nCover: Positive, Negative, Authentication, Authorization, Validation, Boundary, Missing parameters, Invalid JSON, Incorrect data types, Duplicate request, Rate limit, Timeout, 5xx server errors, Response schema validation, Response headers.\nProvide Postman test script snippets for assertions."
    },
    {
      "id": "prompt-edge-v1",
      "created_at": "2026-09-30T10:00:13.247Z",
      "updated_at": "2026-09-30T10:00:13.247Z",
      "feature": "edge_case_detection",
      "version": "v1.2.0",
      "is_active": true,
      "prompt_template": "Act as an Adversarial QA Hacker and Boundary Condition Specialist. Analyze the requirement and existing tests to identify subtle, complex, and unhandled edge cases across:\nEmpty/null values, max/min limits, unicode/special characters, duplicate submissions, concurrent actions & race conditions, network failures, timeouts, session expirations, RBAC permissions, large data volume, pagination anomalies, and dependency outages.\nFor each edge case, provide: missing_scenario, why_it_matters, suggested_test_case, risk_level (High, Medium, Low)."
    },
    {
      "id": "prompt-data-v1",
      "created_at": "2026-09-30T10:00:13.247Z",
      "updated_at": "2026-09-30T10:00:13.247Z",
      "feature": "test_data_generation",
      "version": "v1.1.0",
      "is_active": true,
      "prompt_template": "Act as a Data Quality Architect. Generate realistic, synthetic, privacy-safe test data matching the specified schema, rules, and quantity.\nInclude: valid, invalid, boundary, negative, and edge-case values. Never output real individuals' PII."
    },
    {
      "id": "prompt-bug-v1",
      "created_at": "2026-09-30T10:00:13.247Z",
      "updated_at": "2026-09-30T10:00:13.247Z",
      "feature": "bug_analysis",
      "version": "v1.2.0",
      "is_active": true,
      "prompt_template": "Act as a Root Cause Analysis & Quality Specialist. Convert the reported defect into:\n- bug_summary: string\n- root_cause_hypothesis: string\n- affected_module: string\n- affected_functionality: string\n- reproduction_scenario: string\n- original_test_scenario: string\n- regression_test_scenario: string\n- negative_scenario: string\n- related_test_cases: string[]\n- risk_areas: string[]\n- suggested_additional_tests: string[]\n- regression_test_cases: array of test case objects."
    },
    {
      "id": "prompt-cov-v1",
      "created_at": "2026-09-30T10:00:13.247Z",
      "updated_at": "2026-09-30T10:00:13.247Z",
      "feature": "coverage_analysis",
      "version": "v1.0.0",
      "is_active": true,
      "prompt_template": "Act as a QA Traceability Lead. Analyze requirement coverage against test cases. Calculate complete, partial, or missing coverage, identify untested acceptance criteria, and highlight risk levels."
    },
    {
      "id": "prompt-qual-v1",
      "created_at": "2026-09-30T10:00:13.247Z",
      "updated_at": "2026-09-30T10:00:13.247Z",
      "feature": "test_case_quality_review",
      "version": "v1.1.0",
      "is_active": true,
      "prompt_template": "Act as a QA Review Board Inspector. Audit test cases for duplicate scenarios, missing preconditions or expected results, unclear steps, non-testable language, missing negative/boundary coverage, and improper priorities. Return an overall quality_score (0-100) and actionable suggestions."
    }
  ],
